name = "f4ah6o/direct_sdk"

version = "0.11.2"

import {
  "moonbitlang/quickcheck@0.14.0",
  "moonbitlang/x@0.5.5",
  "moonbitlang/async@0.22.4",
  "f4ah6o/uuidm@0.2.1",
}

readme = "README.mbt.md"

repository = "https://github.com/f4ah6o/direct_sdk.mbt"

license = "Apache-2.0"

keywords = [ "direct", "websocket", "rpc", "msgpack", "chat", "api" ]

description = "MoonBit SDK for Direct4B WebSocket API with MessagePack RPC"

source = "src"

preferred_target = "native"
