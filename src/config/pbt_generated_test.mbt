// Generated by Aletheia - MoonBit PBT Tool
// Property-Based Test Targets for config

///|
let timeout_gen : @gen.Gen[Int] = @gen.int_range(0, 400000)

///|
test "prop_validate_timeout_bounds" {
  @qc.quick_check(
    @qc.forall(timeout_gen, fn(timeout : Int) {
      let cfg = @config.default_config()
        |> @config.with_timeout(timeout)
        |> @config.with_token("test")
      match @config.validate(cfg) {
        Err(_msg) => timeout < 100 || timeout > 300_000
        Ok(_) => timeout >= 100 && timeout <= 300_000
      }
    }),
  )
}

///|
test "prop_apply_defaults_idempotent" {
  @qc.quick_check(
    @qc.forall(timeout_gen, fn(timeout : Int) {
      let cfg = @config.default_config()
        |> @config.with_timeout(timeout)
        |> @config.with_token("dummy")
      let first = @config.apply_defaults(cfg)
      let second = @config.apply_defaults(first)
      second.endpoint == first.endpoint &&
      second.timeout == first.timeout &&
      second.name == first.name
    }),
  )
}
