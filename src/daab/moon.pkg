import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/async/process",
  "moonbitlang/async/stdio",
  "f4ah6o/direct_sdk/constants",
  "f4ah6o/direct_sdk/errors",
  "f4ah6o/direct_sdk/rpc/msgpack" @rpc_msgpack,
  "f4ah6o/direct_sdk/rpc/websocket" @rpc_websocket,
  "f4ah6o/direct_sdk/types",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
}

import {
  "moonbitlang/x/fs",
  "f4ah6o/direct_sdk/types",
} for "test"

pkgtype(kind: "executable")

supported_targets = "+native+js"

options(
  targets: {
    "args.mbt": [ "native" ],
    "create.mbt": [ "native" ],
    "env.mbt": [ "native" ],
    "file_ops.mbt": [ "native" ],
    "init.mbt": [ "native" ],
    "login.mbt": [ "native" ],
    "login_test.mbt": [ "native" ],
    "main.mbt": [ "native" ],
    "main_js.mbt": [ "js", "wasm", "wasm-gc" ],
    "pkg.generated.mbti": [ "native" ],
    "run.mbt": [ "native" ],
    "usage.mbt": [ "native" ],
    "version.mbt": [ "native" ],
    "version_wbtest.mbt": [ "native" ],
  },
)
