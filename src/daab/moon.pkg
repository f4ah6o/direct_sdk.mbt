import {
  "moonbitlang/async" @async,
  "moonbitlang/async/io",
  "moonbitlang/async/process" @process,
  "moonbitlang/async/stdio" @stdio,
  "f4ah6o/direct_sdk/constants" @constants,
  "f4ah6o/direct_sdk/errors" @errors,
  "f4ah6o/direct_sdk/rpc/msgpack" @rpc_msgpack,
  "f4ah6o/direct_sdk/rpc/websocket" @rpc_websocket,
  "f4ah6o/direct_sdk/types" @types,
  "moonbitlang/core/json" @json,
  "moonbitlang/x/fs" @fs,
  "moonbitlang/x/path" @path,
  "moonbitlang/x/sys" @sys,
}

import {
  "moonbitlang/x/fs" @fs,
  "f4ah6o/direct_sdk/types" @types,
} for "test"

options(
  "is-main": true,
  "supported-targets": [ "native", "js" ],
  targets: {
    "args.mbt": [ "native" ],
    "create.mbt": [ "native" ],
    "env.mbt": [ "native" ],
    "file_ops.mbt": [ "native" ],
    "init.mbt": [ "native" ],
    "login.mbt": [ "native" ],
    "login_test.mbt": [ "native" ],
    "main.mbt": [ "native" ],
    "main_js.mbt": [ "js", "wasm", "wasm-gc" ],
    "pkg.generated.mbti": [ "native" ],
    "run.mbt": [ "native" ],
    "usage.mbt": [ "native" ],
    "version.mbt": [ "native" ],
  },
)
