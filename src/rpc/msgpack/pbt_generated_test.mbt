///|
test "prop_encode_request_decode_message_roundtrip" {
  @qc.quick_check(
    @qc.forall(pbt_int_gen, fn(msg_id_int : Int) {
      let msg_id = msg_id_int.to_int64()
      let req = create_request(msg_id, "test_method", [@types.JsonNull])
      match encode_request(req) {
        Ok(bytes) =>
          match decode_message(bytes) {
            Ok(Request(decoded)) =>
              decoded.msg_type == req.msg_type &&
              decoded.msg_id == req.msg_id &&
              decoded.rpc_method == req.rpc_method
            _ => false
          }
        Err(_) => false
      }
    }),
  )
}

